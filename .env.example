# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Microsoft Bot Framework (from Azure Bot registration)
MICROSOFT_APP_ID=your_microsoft_app_id_here
MICROSOFT_APP_PASSWORD=your_microsoft_app_password_here

# PostgreSQL (Railway provides this automatically as DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Server
PORT=3000
